# Release signing credentials — COPY this file to `keystore.properties` and fill in
# your real values. `keystore.properties` and the .jks are gitignored; keep the .jks
# and these passwords backed up somewhere safe: LOSE THEM AND YOU CAN NEVER UPDATE
# THE APP ON GOOGLE PLAY.
#
# 1) Generate a keystore (run once, from tds-android/android/):
#      keytool -genkeypair -v -keystore tds-release.jks \
#        -alias tds -keyalg RSA -keysize 2048 -validity 10000
#    Answer the prompts and choose a strong password.
#
# 2) Copy this file to keystore.properties and set:

storeFile=tds-release.jks
storePassword=CHANGE_ME
keyAlias=tds
keyPassword=CHANGE_ME
