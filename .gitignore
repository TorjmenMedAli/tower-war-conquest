# Dependencies (regenerate with `npm install`)
node_modules/

# Build outputs
build/
dist/
*.apk
*.aab
*.dex

# Signing secrets — NEVER commit (lose these = can't update the app on Play)
*.jks
*.keystore
keystore.properties

# Capacitor: machine-specific + regenerated by `npx cap sync`
tds-android/android/local.properties
tds-android/android/app/src/main/assets/public/
tds-android/android/app/src/main/assets/capacitor.config.json
tds-android/android/app/src/main/assets/capacitor.plugins.json

# Capacitor iOS: dependencies + regenerated by `pod install` / `npx cap sync ios`
tds-android/ios/App/Pods/
tds-android/ios/App/App/public/
tds-android/ios/App/App/capacitor.config.json
xcuserdata/

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
.vscode/

# Claude Code local settings
.claude/

# Play Console debug symbols (build output)
tds-android/native-debug-symbols/
tds-android/native-debug-symbols.zip

# Sprite renderer scratch output (the finished PNGs live in tds-web/assets/sprites)
tds-web/tools/sprites/
